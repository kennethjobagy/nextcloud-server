# Nextcloud Stack - Environment Variables
# =========================================
# IMPORTANT: Keep this file secure!
# - Never commit this file to git
# - Never share this file
# - Set restrictive permissions: chmod 600 .env
#
# Generate secure passwords with:
# openssl rand -base64 32

# =========================================
# SYSTEM SETTINGS
# =========================================

# Your Linux user ID (find with: id -u)
PUID=1000

# Your Linux group ID (find with: id -g)
PGID=1000

# Your timezone
TZ=America/Edmonton

# =========================================
# NEXTCLOUD SETTINGS
# =========================================

# Your Nextcloud domain
NEXTCLOUD_DOMAIN=cloud.yourdomain.com

# Trusted proxy subnet (find with: docker network inspect caddy_net | grep Subnet)
TRUSTED_PROXIES=172.23.0.0/16

# PHP memory limit
PHP_MEMORY_LIMIT=512M

# PHP upload limit
PHP_UPLOAD_LIMIT=10G

# Path to store Nextcloud user data (replace 'username' with your actual username)
NEXTCLOUD_DATA_PATH=/mnt/cloud/nextcloud_data

# =========================================
# DATABASE SETTINGS
# =========================================

# MariaDB database name
MYSQL_DATABASE=nextcloud

# MariaDB nextcloud username
MYSQL_USER=nextcloud

# MariaDB password for nextcloud user
# Generate with: openssl rand -base64 32
MYSQL_PASSWORD=insertpasswordhere

# MariaDB root password
# Generate with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=insertpasswordhere

# =========================================
# REDIS SETTINGS
# =========================================

# Redis host (matches container name)
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379
